{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/state-of-the-art-webai/schema/layers.schema.json",
  "title": "State of the Art of WebAI: data/layers.yml",
  "description": "Spec version 0.5. See SPEC.md.",
  "type": "object",
  "required": [
    "spec",
    "layers"
  ],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "const": "0.5",
      "description": "Version of the spec this file follows."
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 40
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 300
    },
    "level": {
      "enum": [
        "primary",
        "trusted",
        "calculation"
      ]
    },
    "status": {
      "enum": [
        "proposal",
        "experimental",
        "open-question",
        "stable",
        "origin-trial",
        "preview"
      ]
    },
    "sourceGroup": {
      "enum": [
        "docs",
        "spec",
        "code",
        "papers",
        "blog",
        "status"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "url",
        "accessed",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        }
      }
    },
    "treeSource": {
      "type": "object",
      "required": [
        "url",
        "accessed",
        "level",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "group": {
          "$ref": "#/$defs/sourceGroup"
        }
      }
    },
    "chip": {
      "type": "object",
      "required": [
        "id",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/treeSource"
          },
          "description": "At least two sources with distinct urls; preferably from different groups."
        },
        "alert": {
          "$ref": "#/$defs/alert"
        },
        "featured": {
          "type": "boolean",
          "description": "false: the chip is not drawn on the figure or the page, and appears in the README list under 'Also exists'. Default true."
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "chips"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "band": {
          "enum": [
            "accel",
            "bridge"
          ],
          "description": "Optional. The group is drawn in a link band between two lanes instead of inside its layer's card: 'accel' (between build and use) or 'bridge' (between use and agents)."
        },
        "row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "chips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/chip"
          }
        }
      }
    },
    "where": {
      "type": "object",
      "required": [
        "id",
        "icon",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "icon": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "panel": {
      "type": "object",
      "required": [
        "id",
        "icon",
        "groups"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "icon": {
          "$ref": "#/$defs/id"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "n",
        "icon",
        "lane",
        "layout",
        "groups"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "icon": {
          "$ref": "#/$defs/id"
        },
        "lane": {
          "enum": [
            "build",
            "use",
            "agents"
          ],
          "description": "The lane (audience) the layer belongs to: 'build' a model, 'use' a model in an app, or make a site 'agents'-ready. A lane is a row of steps read from left to right, in the order of n."
        },
        "layout": {
          "enum": [
            "cols",
            "rows"
          ]
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "where": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/where"
          }
        },
        "panel": {
          "$ref": "#/$defs/panel"
        }
      }
    },
    "alertLevel": {
      "enum": [
        "critical",
        "warning",
        "info"
      ]
    },
    "alertKind": {
      "enum": [
        "broken-link",
        "removed",
        "deprecated",
        "superseded",
        "moved"
      ]
    },
    "alert": {
      "type": "object",
      "required": [
        "level",
        "kind",
        "observed",
        "evidence"
      ],
      "additionalProperties": false,
      "description": "A problem someone observed, with the day and the evidence. Separate from `status`, which is the project's life cycle.",
      "properties": {
        "level": {
          "$ref": "#/$defs/alertLevel"
        },
        "kind": {
          "$ref": "#/$defs/alertKind"
        },
        "observed": {
          "$ref": "#/$defs/date"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/url"
          }
        }
      }
    }
  }
}
